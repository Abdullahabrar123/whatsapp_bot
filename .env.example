# ==============================================================================
# WHATSAPP BUSINESS PLATFORM CHATBOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to git!).
# 2. Fill in your business-specific Meta Cloud API credentials and secrets.
# 3. Restart the application to apply changes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security Settings
# ------------------------------------------------------------------------------
# Allowed values: development, test, staging, production
APP_ENV=development

# 32+ character secret key used to derive encryption keys for phone numbers and messages
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change_me_to_a_secure_random_32_character_secret_key!

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# Operator Admin API key for protected operations (/admin/*)
# Must be at least 24 characters in production
ADMIN_API_KEY=change_me_to_an_admin_api_key_min_24_chars

# ------------------------------------------------------------------------------
# 2. Storage & Databases
# ------------------------------------------------------------------------------
# Database connection string:
# SQLite (development/test): sqlite+aiosqlite:///./var/app.sqlite3
# PostgreSQL (production)   : postgresql+asyncpg://user:password@localhost:5432/wa_bot
DATABASE_URL=sqlite+aiosqlite:///./var/app.sqlite3

# Redis connection for background worker queue (arq)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Meta Cloud API Credentials (Per-Business Identity)
# ------------------------------------------------------------------------------
# Official Meta Graph API version
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# WhatsApp Business Account (WABA) ID from Meta Business Manager
META_WABA_ID=your_meta_waba_id_here

# Meta Phone Number ID (NOT your raw phone number) from Meta Developer Portal
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Permanent System User Access Token with 'whatsapp_business_messaging' permissions
META_ACCESS_TOKEN=your_meta_system_user_permanent_access_token_here

# Meta App Secret from App Settings -> Basic (used to verify inbound webhook signatures)
META_APP_SECRET=your_meta_app_secret_here

# Custom verify token configured in Meta App Webhook settings
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# ------------------------------------------------------------------------------
# 4. Local LLM Settings (Ollama)
# ------------------------------------------------------------------------------
# Provider: 'ollama' (local LLM) or 'deterministic' (rule-based offline test provider)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Default model: qwen3:4b (or qwen3:1.7b for memory-constrained hosts)
LLM_MODEL=qwen3:4b
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192

# Disable extended reasoning to keep customer service responses fast and concise
LLM_ENABLE_THINKING=false
